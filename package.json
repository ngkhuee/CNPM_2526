{
  "name": "food-delivery",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/customer/web",
    "apps/customer/mobile",
    "apps/customer/shared",
    "apps/restaurant-web",
    "apps/admin-web",
    "packages/*",
    "mock-backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:customer-web": "npm run dev --workspace=customer-web",
    "dev:restaurant": "npm run dev --workspace=restaurant-web",
    "dev:admin": "npm run dev --workspace=admin-web",
    "dev:mock": "npm run dev --workspace=mock-backend",
    "dev:all": "concurrently \"npm run dev:mock\" \"npm run dev:customer-web\" \"npm run dev:restaurant\" \"npm run dev:admin\"",
    "dev:frontend": "concurrently \"npm run dev:customer-web\" \"npm run dev:restaurant\" \"npm run dev:admin\"",
    "build:all": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1",
    "eslint": "^8.56.0"
  }
}
