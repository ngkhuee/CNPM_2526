# Mobile App Configuration
# Copy this file to .env and customize for your environment

# Development Environment
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL=http://192.168.0.127:4000

# Staging Environment (uncomment to use)
# EXPO_PUBLIC_ENV=staging
# EXPO_PUBLIC_API_URL=https://api-staging.yummy.com

# Production Environment (uncomment to use)
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_API_URL=https://yummy-backend-3t5z.onrender.com
