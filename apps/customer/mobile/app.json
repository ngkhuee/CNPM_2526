{
    "expo": {
        "name": "Yummy Delivery",
        "slug": "yummy-delivery-customer",
        "version": "1.0.0",
        "sdkVersion": "54.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "icon": "./assets/icon.svg",
        "splash": {
            "image": "./assets/splash.svg",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "android": {
            "package": "com.yummy.customer",
            "versionCode": 1,
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.svg",
                "backgroundColor": "#ffffff"
            }
        },
        "ios": {
            "supportsTabletMode": true,
            "bundleIdentifier": "com.yummy.customer"
        },
        "plugins": [
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Allow Yummy to access your location."
                }
            ]
        ]
    }
}
